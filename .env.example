
# --- Kura backend (required for dashboard features) ---
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080
# Production: NEXT_PUBLIC_BACKEND_URL=https://api.kura-finance.com

# --- Web app origin (CORS, CSP, WebAuthn, Privy allowed origins) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production: NEXT_PUBLIC_APP_URL=https://app.kura-finance.com

# --- API origin for CSP connect-src (defaults to api.kura-finance.com) ---
# NEXT_PUBLIC_API_URL=https://api.kura-finance.com

# --- Privy (required for login) — https://dashboard.privy.io ---
NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id

# --- Reown / WalletConnect (required for Web3 wallet connect) — https://cloud.reown.com ---
NEXT_PUBLIC_REOWN_PROJECT_ID=your_reown_project_id

# --- logo.dev (optional — sharper stock / crypto ticker icons) — https://www.logo.dev ---
# NEXT_PUBLIC_LOGODEV_TOKEN=pk_xxx

# --- Base RPC (recommended for Home / Portfolio / Safe owners) ---
# Public mainnet.base.org rate-limits aggressively (429). Prefer Alchemy.
# NEXT_PUBLIC_ALCHEMY_API_KEY=your_alchemy_key
# NEXT_PUBLIC_BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/your_alchemy_key

# --- Pimlico (required for Smart Wallet UserOps on Base) ---
# Used by: Transfer (Send crypto), Earn deposit/withdraw, Borrow, Markets swap
# when acting from the personal Smart Wallet (not Treasury propose).
# NEXT_PUBLIC_PIMLICO_API_KEY=pim_xxx
# NEXT_PUBLIC_PAY_GAS_IN_USDC=true

# --- Li.Fi (optional — cross-chain Send / swap fee share + rate limits) ---
# NEXT_PUBLIC_LIFI_FEE is Li.Fi's integrator fee as a fraction of 1
# (e.g. 0.25 = 25%). Production CI sets this to 0.25 — keep local in sync
# unless you intentionally test a lower share.
# NEXT_PUBLIC_LIFI_INTEGRATOR=kura
# NEXT_PUBLIC_LIFI_FEE=0.25
# NEXT_PUBLIC_LIFI_API_KEY=

# --- Stripe plan price IDs (optional — billing UI) — https://dashboard.stripe.com ---
# NEXT_PUBLIC_STRIPE_PRICE_PRO_MONTHLY=price_xxx
# NEXT_PUBLIC_STRIPE_PRICE_PRO_YEARLY=price_xxx
# NEXT_PUBLIC_STRIPE_PRICE_ULTIMATE_MONTHLY=price_xxx
# NEXT_PUBLIC_STRIPE_PRICE_ULTIMATE_YEARLY=price_xxx

# --- Build mode (optional; Dockerfile sets BUILD_MODE=standalone) ---
# BUILD_MODE=export         # static export for CDN — npm run build:static
